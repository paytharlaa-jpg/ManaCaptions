# ==============================================================================
# TELUGU CAPTIONS STUDIO - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# All keys listed here are strictly server-side environment variables.
# Never expose these keys to the frontend or commit actual values to git.

# ------------------------------------------------------------------------------
# 1. AI SPEECH & CAPTIONS PROVIDERS (Server-side)
# ------------------------------------------------------------------------------
# Google Gemini (Recommended - 2.5 Flash for Multimodal Audio, Telugu & Viral Hooks)
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Whisper (Alternative - Ultra fast transcription & fast LLM translation)
# Get key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Sarvam AI (Optional - Saaras Indic ASR)
# Get key at: https://www.sarvam.ai/
SARVAM_API_KEY=

# Preferred ASR provider: 'gemini' | 'groq' | 'sarvam'
ASR_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH 2.0 (Google Sign-In)
# ------------------------------------------------------------------------------
# Setup at: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin: http://localhost:3000
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 2.1 EMAIL OTP VERIFICATION (Resend API)
# ------------------------------------------------------------------------------
# Get free API key at: https://resend.com/ (100 free emails/day)
# In development without an API key, OTP codes log directly to terminal console.
RESEND_API_KEY=
EMAIL_FROM=ManaCaptions <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 3. PAYMENTS - RAZORPAY (Phase 3)
# ------------------------------------------------------------------------------
# Get keys at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE TURNSTILE (Phase 6 - Guest Trial Bot Protection)
# ------------------------------------------------------------------------------
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
